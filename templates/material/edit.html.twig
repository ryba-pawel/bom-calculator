{% extends 'base.html.twig' %}

{% block title %}Edycja: {{ material_name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_material_index') }}">Materiały</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_material_show', {id: material.id}) }}">{{ material_name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edycja</li>
        </ol>
    </nav>

    <div class="card shadow-sm" style="max-width: 40rem">
        <div class="card-body">
            <h1 class="h4 card-title mb-3">Edycja materiału</h1>
            {{ include('material/_form.html.twig', {button_label: 'Zapisz zmiany'}) }}
        </div>
        <div class="card-footer">
            {{ include('material/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
