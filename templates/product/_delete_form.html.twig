<form method="post" action="{{ path('app_product_delete', {id: product.id}) }}" onsubmit="return confirm('Na pewno usunąć ten produkt razem z jego BOM?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
    <button class="btn btn-outline-danger">Usuń</button>
</form>
