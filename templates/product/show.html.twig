{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_product_index') }}">Produkty</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">{{ product.name }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn btn-outline-secondary">Edytuj</a>
            {{ include('product/_delete_form.html.twig') }}
        </div>
    </div>

    <p class="text-body-secondary">Marża: <strong>{{ product.marginPercent|decimal }}%</strong></p>
{% endblock %}
