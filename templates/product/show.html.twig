{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_product_index') }}">Produkty</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">{{ product.name }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn btn-outline-secondary">Edytuj</a>
            {{ include('product/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-body-secondary small">Koszt materiałów</div>
                    <div class="fs-4 fw-semibold">{{ cost.materialsCost|pln }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-body-secondary small">Marża ({{ cost.marginPercent|decimal }}%)</div>
                    <div class="fs-4 fw-semibold">+ {{ cost.marginAmount|pln }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-body">
                    <div class="text-primary small">Cena końcowa</div>
                    <div class="fs-4 fw-bold text-primary">{{ cost.finalPrice|pln }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-body fw-semibold">Lista materiałów (BOM)</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Materiał</th>
                        <th class="text-end">Ilość</th>
                        <th class="text-end">Cena jedn.</th>
                        <th class="text-end">Wartość</th>
                        <th class="text-end"><span class="visually-hidden">Akcje</span></th>
                    </tr>
                </thead>
                <tbody>
                {% for line in cost.items %}
                    <tr>
                        <td><a href="{{ path('app_material_show', {id: line.materialId}) }}">{{ line.materialName }}</a></td>
                        <td class="text-end text-nowrap">{{ line.quantity|decimal }} {{ line.unit }}</td>
                        <td class="text-end text-nowrap">{{ line.unitPrice|pln }}</td>
                        <td class="text-end text-nowrap fw-semibold">{{ line.totalCost|pln }}</td>
                        <td class="text-end">
                            <form method="post"
                                  action="{{ path('app_product_bom_item_delete', {id: product.id, bomItemId: line.bomItemId}) }}"
                                  onsubmit="return confirm('Usunąć tę pozycję z BOM?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-bom-item' ~ line.bomItemId) }}">
                                <button class="btn btn-sm btn-outline-danger">Usuń</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-body-secondary py-4">BOM jest pusty – dodaj pierwszy materiał poniżej.</td>
                    </tr>
                {% endfor %}
                </tbody>
                {% if cost.items is not empty %}
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Razem materiały</th>
                            <th class="text-end text-nowrap">{{ cost.materialsCost|pln }}</th>
                            <th></th>
                        </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>
        <div class="card-footer bg-body py-3">
            <h2 class="h6 mb-3">Dodaj pozycję do BOM</h2>
            {{ form_start(bom_form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="row g-2">
                    <div class="col-md-7">{{ form_row(bom_form.material) }}</div>
                    <div class="col-md-3">{{ form_row(bom_form.quantity) }}</div>
                    <div class="col-md-2 pt-md-4 mt-md-2">
                        <button class="btn btn-primary w-100">Dodaj</button>
                    </div>
                </div>
            {{ form_end(bom_form) }}
        </div>
    </div>
{% endblock %}
