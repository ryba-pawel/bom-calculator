{% extends 'base.html.twig' %}

{% block title %}Kalkulator kosztów{% endblock %}

{% block body %}
    <div id="calculator"
         data-products-url="{{ path('api_product_list') }}"
         data-product-page-url="{{ path('app_product_index') }}">
        <h1 class="h3 mb-1">Kalkulator kosztów</h1>
        <p class="text-body-secondary mb-4">
            Wybierz produkt – rozbicie kosztów pobierane jest z API bez przeładowania strony
            (<a href="{{ path('api_product_list') }}"><code>GET /api/products</code></a>,
            <code>GET /api/products/{id}/cost</code>).
        </p>

        <div class="card shadow-sm mb-4" style="max-width: 32rem">
            <div class="card-body">
                <label for="product-select" class="form-label">Produkt</label>
                <select id="product-select" class="form-select" disabled>
                    <option>Ładowanie produktów…</option>
                </select>
            </div>
        </div>

        <div id="calculator-result" aria-live="polite"></div>
    </div>

    {# Szablony HTML wypełniane przez JS (textContent – bez ryzyka XSS) #}
    <template id="cost-table-template">
        <div class="card shadow-sm">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <span class="fw-semibold" data-field="productName"></span>
                <a class="small" data-slot="product-link">Edytuj BOM →</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Materiał</th>
                            <th class="text-end">Ilość</th>
                            <th class="text-end">Cena jedn.</th>
                            <th class="text-end">Wartość</th>
                        </tr>
                    </thead>
                    <tbody data-slot="items"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end fw-normal">Koszt materiałów</th>
                            <td class="text-end text-nowrap" data-field="materialsCost"></td>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end fw-normal">Marża (<span data-field="marginPercent"></span>%)</th>
                            <td class="text-end text-nowrap" data-field="marginAmount"></td>
                        </tr>
                        <tr class="table-primary">
                            <th colspan="3" class="text-end">Cena końcowa</th>
                            <td class="text-end text-nowrap fw-bold" data-field="finalPrice"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </template>

    <template id="cost-row-template">
        <tr>
            <td data-field="materialName"></td>
            <td class="text-end text-nowrap" data-field="quantity"></td>
            <td class="text-end text-nowrap" data-field="unitPrice"></td>
            <td class="text-end text-nowrap fw-semibold" data-field="totalCost"></td>
        </tr>
    </template>

    <template id="cost-empty-template">
        <tr>
            <td colspan="4" class="text-center text-body-secondary py-4">Ten produkt nie ma jeszcze pozycji BOM.</td>
        </tr>
    </template>

    <template id="loading-template">
        <div class="d-flex align-items-center gap-2 text-body-secondary">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Liczę koszty…</span>
        </div>
    </template>

    <template id="error-template">
        <div class="alert alert-danger" role="alert" data-field="message"></div>
    </template>
{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ asset('js/calculator.js') }}"></script>
{% endblock %}
